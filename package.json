{
  "name": "tabby-et",
  "version": "1.0.0",
  "description": "Eternal Terminal plugin for Tabby",
  "keywords": ["tabby-plugin", "eternal-terminal"],
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --config webpack.config.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:regressions": "node scripts/verify-regressions.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "watch": "webpack --config webpack.config.mjs --watch --devtool source-map",
    "prepack": "npm run build"
  },
  "files": ["dist/index.js"],
  "author": "Relihan Myburgh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qoke/tabby-et.git"
  },
  "bugs": "https://github.com/qoke/tabby-et/issues",
  "homepage": "https://github.com/qoke/tabby-et#readme",
  "devDependencies": {
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@tabby-gang/to-string-loader": "^1.1.7-beta.2",
    "@types/node": "^22.0.0",
    "ansi-colors": "^4.1.1",
    "apply-loader": "2.0.0",
    "css-loader": "^6.7.3",
    "pug": "^2.0.3",
    "pug-loader": "^2.4.0",
    "sass": "^1.63.4",
    "sass-loader": "^13.2.0",
    "shell-quote": "1.7.4",
    "strip-ansi": "^7.0.0",
    "thenby": "^1.3.4",
    "ts-loader": "^9.4.2",
    "tweetnacl": "^1.0.3",
    "typescript": "^4.9.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.0.1",
    "zone.js": "^0.13.0"
  },
  "peerDependencies": {
    "@angular/common": "^15",
    "@angular/core": "^15",
    "@angular/forms": "^15",
    "@ng-bootstrap/ng-bootstrap": "^14",
    "ngx-toastr": "^16",
    "rxjs": "^7",
    "tabby-core": "*",
    "tabby-settings": "*",
    "tabby-ssh": "*",
    "tabby-terminal": "*"
  },
  "peerDependenciesMeta": {
    "@angular/common": { "optional": true },
    "@angular/core": { "optional": true },
    "@angular/forms": { "optional": true },
    "@ng-bootstrap/ng-bootstrap": { "optional": true },
    "ngx-toastr": { "optional": true },
    "rxjs": { "optional": true },
    "tabby-core": { "optional": true },
    "tabby-settings": { "optional": true },
    "tabby-ssh": { "optional": true },
    "tabby-terminal": { "optional": true }
  }
}
